{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "CampusCartTablesOnly",
    "Effect": "Allow",
    "Action": ["dynamodb:ConditionCheckItem", "dynamodb:DescribeTable", "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Scan", "dynamodb:Query"],
    "Resource": [
      "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PREFIX-users",
      "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PREFIX-products",
      "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PREFIX-carts",
      "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PREFIX-orders",
      "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/PREFIX-discounts"
    ]
  }]
}
